<h1>Feed</h1>

<%= link_to "New Post", new_post_path %>
<%= button_to "Logout", logout_path, method: :delete %>

<hr>

<% @posts.each do |post| %>
  <div style="border: 1px solid #ccc; margin: 10px; padding: 10px;">
    <strong><%= post.user.username %></strong>
    <p><%= post.content %></p>
    <small><%= post.created_at %></small>
  </div>
<% end %>
