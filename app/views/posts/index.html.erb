<h2>Create post</h2>

<%= form_with scope: :post, url: posts_path, method: :post do |f| %>
  <div>
    <%= f.text_area :content, placeholder: "What's happening?", maxlength: 280 %>
  </div>

  <%= f.submit "Post" %>
<% end %>

<hr>

<h2>Feed</h2>

<% @posts.each do |post| %>
  <div style="border: 1px solid #ccc; padding: 10px; margin-bottom: 10px;">
    <strong><%= post.user.username %></strong><br>
    <%= post.content %><br>
    <small><%= post.created_at.strftime("%H:%M %d.%m.%Y") %></small>
  </div>
<% end %>

<%= button_to "Logout", logout_path, method: :delete %>


