<h1>Login</h1>

<%= form_with url: login_path, method: :post do %>
  <div>
    <%= label_tag :username %>
    <%= text_field_tag :username %>
  </div>

  <div>
    <%= label_tag :password %>
    <%= password_field_tag :password %>
  </div>

  <%= submit_tag "Login" %>
  <%= link_to "Sign up", new_user_path %>
<% end %>
